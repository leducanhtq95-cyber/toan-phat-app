{
  "name": "toan-phat-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "description": "Phần mềm Toàn Phát chạy trên Windows",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "vn.ap.toanphat",
    "productName": "Toàn Phát",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ToanPhat-Portable.exe"
    },
    "nsis": {
      "artifactName": "ToanPhat-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  }
}